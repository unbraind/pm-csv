{"ts":"2026-07-24T21:17:28.014Z","author":"codex","op":"close","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-07-24T21:17:28.014Z"},{"op":"replace","path":"/metadata/status","value":"closed"},{"op":"add","path":"/metadata/closed_at","value":"2026-07-24T21:17:28.013Z"},{"op":"add","path":"/metadata/resolution","value":"Fixed in 2026.6.7 — export terminator derived from the same eol as record separators"},{"op":"add","path":"/metadata/expected_result","value":"--excel/--crlf output is uniformly CRLF including the trailing terminator (no lone LF); default (LF) export unchanged"},{"op":"add","path":"/metadata/actual_result","value":"Real-data test on published pm-csv against a throwaway tracker with 2 items: excel.csv = 319 bytes, crlf=3, lone_lf=0, ends_crlf=True; plain.csv = 313 bytes, cr=0, lf=3, ends_lf=True. Default export unchanged."},{"op":"add","path":"/metadata/close_reason","value":"Fix shipped in v2026.06.07 (commit 616b05f, PR #6): buildCsvExport now derives eol from opts.crlf||opts.excel and both write sites use it, so the final record terminator matches the rest of the file. Tracker closed late; --release 2026.6.7 pins changelog attribution to the release that actually shipped it."}],"before_hash":"15e81c3bec1c89656ca171771213f93bbbd052ec50758f58d107c766ed978d88","after_hash":"c37b2ff99c7e36bb20108f39c21cac923ec16075aaabdd07859294e6a21aa23a"}

{"ts":"2026-07-24T21:33:28.836Z","author":"claude","op":"note_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-07-24T21:33:28.836Z"},{"op":"add","path":"/metadata/notes","value":[{"created_at":"2026-07-24T21:33:28.836Z","author":"claude","text":"Release field uses the zero-padded git-tag spelling 2026.06.07 rather than the unpadded 2026.6.7 shown in the changelog heading. Reason: pm-changelog 2026.7.24 compares release keys literally, so only the padded form matches the window built from tag v2026.06.07 (tracked as pm-changelog pmc-2sfc, fix in pm-changelog PR 94). Once that fix publishes either spelling resolves to the same key and no change is needed here."}]}],"before_hash":"f3e762ae256a65d437716d71d8400168938235755ed050759f69c420755dfe7d","after_hash":"0f6ffe7e1029095e3a90ebbaec8111553edf958a0fef7bd981436488ba52104a"}

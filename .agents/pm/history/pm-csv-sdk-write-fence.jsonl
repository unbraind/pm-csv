{"hash_algorithm":"sha256","ts":"2026-10-22T13:46:22.966Z","author":"codex-agent","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"60205bbb5b285c4b3060e68d","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-csv-sdk-write-fence"},{"op":"add","path":"/metadata/title","value":"Host SDK allows stale item writes after lease takeover"},{"op":"add","path":"/metadata/description","value":"PR 179 thread PRRT_kwDOSYpI8s6vNO6H is valid in pinned pm CLI SDK 2026.10.15. A real non-git tracker reproduction uses one-second item leases and configured automatic stale takeover: a second native writer commits while the first mutateItem callback is suspended; the stale first call then returns successfully and overwrites the second value. mutateItemWithDeferredHistoryContext persists after the callback without an atomic lease-ownership or document-revision fence. Fix belongs to the host SDK; queue rules forbid editing upstream pm-cli in this workstream. This package cannot honestly certify protection after lease expiry until that host contract is fixed."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-10-22T13:46:22.966Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-22T13:46:22.966Z"},{"op":"add","path":"/metadata/author","value":"codex-agent"},{"op":"add","path":"/metadata/expected_result","value":"The host atomically refuses stale item persistence when lease ownership or document revision changed, preserving the newer value and allowing safe transaction reconciliation."},{"op":"add","path":"/metadata/actual_result","value":"Standalone node --test test/repros/sdk-lease-overrun.ts: 0 passed / 1 failed, exit 1. takeoverCompleted=true; staleWriterRefused=false; newerValuePreserved=false. The newer committed value was replaced by the stale writer. Synthetic fixture only; no existing tracker data was used."},{"op":"add","path":"/metadata/files","value":[{"path":"test/repros/sdk-lease-overrun.ts","scope":"project"},{"path":"roundtrip.ts","scope":"project"}]},{"op":"add","path":"/metadata/docs","value":[{"path":"docs/spreadsheet-roundtrip.md","scope":"project"}]}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"17f090f7c7214b84bce44d1a0312ac0b634cddc563e446d6b7a4369eef56c449","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"40c4ed1510b61f691fc20cba9e23a50f44990fc700e8066dca2923d5a4e8fc32"}

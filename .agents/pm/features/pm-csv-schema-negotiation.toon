  index.ts,project
  scripts/accept-packed.ts,project
  scripts/validate-table-schema.ts,project
  table-schema.ts,project
  test/table-schema.test.ts,project
tests[1]{command,scope,provenance{author,created_at,source_kind,source_ref}}:

{
  "name": "pm-csv",
  "version": "2026.8.29",
  "description": "CSV importer and exporter for pm-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbraind/pm-csv.git"
  },
  "bugs": {
    "url": "https://github.com/unbraind/pm-csv/issues"
  },
  "homepage": "https://github.com/unbraind/pm-csv#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "manifest.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node --test test/*.test.ts",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run duplicates",
    "verify:release-workflow": "node .agents/pm/verify-release-yaml.mjs",
    "verify:release-publish-attestation": "node scripts/verify-release-publish-attestation.ts",
    "lint": "eslint --config scripts/eslint.config.ts --max-warnings=0 .",
    "duplicates": "jscpd --config .jscpd.json",
    "audit:prod": "node --input-type=module -e \"import { spawnSync } from 'node:child_process'; import { devNull } from 'node:os'; const env = { ...process.env, npm_config_userconfig: devNull, NPM_CONFIG_USERCONFIG: devNull }; for (const key of Object.keys(env)) if (key.toLowerCase() === 'npm_config_allow_scripts') delete env[key]; const win = process.platform === 'win32'; const r = spawnSync(win ? 'npm.cmd' : 'npm', ['audit', '--omit=dev', '--ignore-scripts'], { stdio: 'inherit', env, shell: win }); process.exit(r.status ?? 1);\"",
    "pack:dry-run": "npm pack --dry-run",
    "accept:packed": "node scripts/accept-packed.ts",
    "changelog:full": "pm-changelog --pm-root .agents/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded --mode replace --output CHANGELOG.md --all-release-tags --release-version-from-package --date-from-version --item-url-base https://github.com/unbraind/pm-csv/blob/main/.agents/pm --respect-item-release",
    "changelog:check": "npm run changelog:full -- --check",
    "release:check": "npm run typecheck && npm run verify:release-workflow && npm run build && npm run lint && npm run duplicates && npm run docstring && npm run coverage && npm run audit:prod && npm run pack:dry-run && npm run accept:packed && npm run changelog:check && npm run verify:release-publish-attestation && npm run verify:release-changelog-date",
    "prepublishOnly": "npm run release:check",
    "release:notes": "pm-changelog --pm-root .agents/pm --pm-arg=--output-budget --pm-arg=unbounded --pm-arg=--output-limit --pm-arg=unbounded --stdout --since-previous-tag --until-release-tag --release-version-from-package --date-from-version --item-url-base https://github.com/unbraind/pm-csv/blob/main/.agents/pm --respect-item-release --pm-bin ./node_modules/.bin/pm --github-step-summary",
    "prepare": "node scripts/prepare-merge-driver.mjs",
    "merge:install": "pm merge install",
    "pm:validate": "pm validate --json",
    "coverage": "npm run build && npm run build:test && node scripts/coverage-gate.ts",
    "docstring": "node scripts/docstring-gate.ts",
    "verify:release-changelog-date": "node scripts/verify-release-changelog-date.ts"
  },
  "coverageGate": {
    "sources": [
      ".",
      "scripts/docstring-gate.ts"
    ],
    "tests": [
      "test/*.test.ts"
    ],
    "thresholds": {
      "lines": 100,
      "branches": 100,
      "functions": 100
    },
    "ignore": []
  },
  "peerDependencies": {
    "@unbrained/pm-cli": ">=2026.8.20"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@types/node": "^26.1.1",
    "@unbrained/pm-cli": "2026.8.27",
    "eslint": "^10.8.1",
    "jiti": "^2.7.0",
    "jscpd": "^5.0.16",
    "pm-changelog": "^2026.8.29",
    "pm-ops": "2026.8.17",
    "typescript": "^7.0.2",
    "yaml": "2.9.0"
  },
  "keywords": [
    "csv",
    "exporter",
    "importer",
    "pm-cli",
    "pm-extension",
    "pm-package"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "author": "@unbraind",
  "pm": {
    "aliases": [
      "csv"
    ],
    "extensions": [
      "."
    ],
    "catalog": {
      "display_name": "CSV Import/Export",
      "category": "import-export",
      "summary": "CSV importer and exporter for pm-cli",
      "tags": [
        "csv",
        "import",
        "export"
      ],
      "links": {
        "docs": "https://github.com/unbraind/pm-csv#readme",
        "npm": "https://www.npmjs.com/package/pm-csv",
        "repository": "https://github.com/unbraind/pm-csv",
        "report": "https://github.com/unbraind/pm-csv/issues"
      }
    },
    "docs": [
      "README.md",
      "CHANGELOG.md"
    ],
    "examples": [
      "README.md"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
